{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "typeRoots": ["./node_modules/@types"],
    "types": ["nativewind/types"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx"
  }
}
