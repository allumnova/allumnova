generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String            @id @default(cuid())
  name             String
  domain           String?           @unique
  subscriptionPlan String            @default("FREE") // FREE, GROWTH, ENTERPRISE
  status           String            @default("ACTIVE") // ACTIVE, SUSPENDED, DELETED
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  users            User[]
  subscriptionLogs SubscriptionLog[]
  workflows        Workflow[]
  invoices         Invoice[]
  aiKnowledgeBase  AiKnowledgeBase[]
  auditLogs        AuditLog[]
  aiTokenMetrics   AiTokenMetric[]
  projects         Project[]
  tasks            Task[]
}

model SubscriptionLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  previousPlan   String?
  newPlan        String?
  changedBy      String?
  createdAt      DateTime     @default(now())
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  password_hash  String
  name           String
  role           String       @default("MEMBER") // ADMIN, MANAGER, MEMBER, CLIENT
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  invoices       Invoice[]    @relation("ClientInvoices")
  auditLogs      AuditLog[]
  sessions       Session[]

  @@unique([organizationId, email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         String       @default("IDEA") // IDEA, BUILDING, MVP, SCALING
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tasks          Task[]
}

model Task {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         String        @default("TODO") // TODO, IN_PROGRESS, REVIEW, DONE
  dueDate        DateTime?
  slaDeadline    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Workflow {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  triggerType    String        // EVENT, CRON, MANUAL
  definition     Json          // State machine configuration
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  runs           WorkflowRun[]
}

model WorkflowRun {
  id           String    @id @default(cuid())
  workflowId   String
  workflow     Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  currentState String
  contextData  Json?
  status       String    @default("RUNNING") // RUNNING, COMPLETED, FAILED
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         User         @relation("ClientInvoices", fields: [clientId], references: [id])
  amount         Decimal
  currency       String       @default("USD")
  status         String       @default("UNPAID") // UNPAID, PAID, OVERDUE, VOID
  dueDate        DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  payments       Payment[]
}

model Payment {
  id                   String   @id @default(cuid())
  invoiceId            String
  invoice              Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentGateway       String   // STRIPE, RAZORPAY, MANUAL
  transactionReference String
  amount               Decimal
  status               String   @default("SUCCESS")
  createdAt            DateTime @default(now())
}

model AiKnowledgeBase {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       String       // GENERAL, CODE, BUSINESS, SALES
  content        String
  embedding      Float[]
  createdAt      DateTime     @default(now())
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  action         String        // e.g. INVOICE_PAID, USER_CREATION
  tableName      String
  recordId       String
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())
}

model AiPrompt {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. REQUIREMENTS_EXTRACTOR
  template  String
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model AiTokenMetric {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String
  promptTokens   Int
  completionTokens Int
  estimatedCostUsd Decimal
  createdAt      DateTime     @default(now())
}
